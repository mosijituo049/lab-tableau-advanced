    <dashboard name='Story 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Understanding Customer Distribution, Value, and Claims</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-description'>
          <format attr='border-width' id='story-description_6' value='0' />
          <format attr='border-style' id='story-description_6' value='none' />
          <format attr='background-color' id='story-description_6' value='#00000000' />
        </style-rule>
        <style-rule element='story-point-caption'>
          <format attr='width' value='543' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3216' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4046' />
            <zone h='84647' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='14523'>
              <flipboard active-id='2' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Customer distribution varies significantly across states, indicating that some regions represent larger customer bases and may require greater marketing and service attention.' captured-sheet='Sheet 6' id='1'>
                    <capturedDeltas>
                      <worksheet name='Sheet 6'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.1ebvr091ov7i0n178pah50fmiap2].[Latitude (generated)]' field-type='quantitative' max='6813575.1946975756' min='3253797.9640222155' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                            <encoding attr='space' class='0' field='[federated.1ebvr091ov7i0n178pah50fmiap2].[Longitude (generated)]' field-type='quantitative' max='-11098568.015472971' min='-14756116.983802322' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                          </style-rule>
                        </style>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='The relationship between income and customer lifetime value appears relatively weak. While higher-income customers may exhibit slightly greater lifetime value, income alone does not strongly predict customer value.' captured-sheet='Sheet 7' id='2' />
                  <story-point caption='Claim amount distributions differ across vehicle size categories. Small vehicles show slightly higher median claim amounts and greater variability, while all categories contain several high-value outliers.' captured-sheet='Sheet 8' id='3' />
                  <story-point caption='Key Findings&#10;' captured-sheet='' id='4' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='52905' hidden='true' id='6' story-point-id='4' type-v2='text' w='59055' x='15453' y='27490'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>• Customer concentration varies across states, suggesting regional differences in market size.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>• Income shows only a weak relationship with Customer Lifetime Value.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>• Vehicle size influences the distribution of claim amounts, although extreme claims occur across all categories.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>• Geographic, demographic, and vehicle-related factors together provide valuable insights for customer segmentation and risk assessment.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{97C60664-3A58-487C-808E-D65C8C3072B4}' />
    </dashboard>
